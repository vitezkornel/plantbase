{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "@ai-sdk/openai": "2.0.135",
    "@ai-sdk/react": "2.0.264",
    "ai": "5.0.261",
    "core": "workspace:*",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remend": "1.4.0",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "nx": {
    "targets": {
      "build": {
        "options": {
          "command": "next build --webpack"
        }
      },
      "dev": {
        "options": {
          "command": "next dev --webpack --port 3001"
        }
      },
      "start": {
        "options": {
          "command": "next start --port 3001"
        }
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "default",
          "^default"
        ],
        "options": {
          "cwd": "apps/web",
          "command": "tsc --noEmit -p tsconfig.json"
        }
      }
    }
  }
}
