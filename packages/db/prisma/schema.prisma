// Prisma schema — packages/db (architektura.md #6: Prisma lib, not repo root)
// Connection URL is configured in ../prisma.config.ts (Prisma 7 config model), not here.

generator client {
  provider        = "prisma-client-js"
  engineType      = "library"
  output          = "../generated/client"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// products (stack.md) — plain-text categorical columns on purpose (no DB enum,
// see konvenciok.md: "string literal union enum helyett" applies to TS, not this SQL table).
model Product {
  id              Int      @id @default(autoincrement())
  name            String? // köznapi név
  latinName       String?  @map("latin_name")
  category        String? // szobanövény / kerti / pozsgás / kaktusz / fűszer / fa-cserje / lógó / virágzó
  location        String? // beltéri / kültéri / mindkettő
  price           Decimal? // ár (HUF)
  salePrice       Decimal? @map("sale_price") // akciós ár (ha van akció), különben null
  stock           Int? // raktárkészlet (db)
  light           String? // árnyék / alacsony / közepes / erős / direkt nap
  watering        String? // ritka / közepes / gyakori / állandóan nedves
  difficulty      String? // kezdő / haladó / profi
  currentHeightCm Int?     @map("current_height_cm") // aktuális magasság
  maxHeightCm     Int?     @map("max_height_cm") // kifejlett (max) magasság
  currentPotCm    Int?     @map("current_pot_cm") // aktuális cserépméret
  petSafe         Boolean? @map("pet_safe") // háziállat-barát
  kidSafe         Boolean? @map("kid_safe") // gyerekbiztos (nem mérgező)
  airPurifying    Boolean? @map("air_purifying") // légtisztító
  rating          Decimal? // 0-5
  reviewsCount    Int?     @map("reviews_count")
  description     String?

  @@map("products")
}

// RAG (HF3, docs/rag-proposal.md #2): chunk-szintű tudásbázis a data/knowledge
// cikkekből, pgvector embeddinggel. A packages/rag ingest-je ír ide (ugyanazon
// read-write DATABASE_URL-en, mint a Product-tábla migrációja/seedje), a
// packages/core egy új tool-ja csak OLVAS innen, a read-only kapcsolaton
// (architektura.md #2 "két kapcsolat, két jog" elvének kiterjesztése).
model KnowledgeChunk {
  id          Int      @id @default(autoincrement())
  articleSlug String   @map("article_slug") // pl. "ask-the-sill__best-floor-planter"
  title       String // grounding: cikk cím
  source      String // grounding: URL
  sectionPath String?  @map("section_path") // szülő-alcím, kontextusként
  content     String
  contentHash String   @map("content_hash") // előretekintés: docs/ARCHITEKTURA.md inkrementális re-ingestjéhez
  embedding   Unsupported("vector(1536)") // Cohere embed-v4.0 default dim — verify against a real API response (cohere-embed-client.ts)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("knowledge_chunks")
  @@index([articleSlug])
}
