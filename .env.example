# Copy this file to `.env` (repo root, gitignored) and fill in real values.
# `.env` is never committed — see docs/konvenciok.md "Biztonság".

# Anthropic API key used by the agent (Part B / packages/core). Get one at
# https://console.anthropic.com/settings/keys.
ANTHROPIC_API_KEY=your-key-here

# Cohere API key: embedding (ingest + query time) and rerank for the RAG
# pipeline (docs/rag-proposal.md #4 routing). Get one at
# https://dashboard.cohere.com/api-keys. Used by packages/rag (ingest) and
# packages/core's search-knowledge tool (query-time).
COHERE_API_KEY=your-key-here

# Prisma read-write connection (schema/migrate/seed, packages/db) and the
# agent's read-only connection (SELECT-only via the plantbase_readonly role
# — see packages/db/sql/create-readonly-role.sql). Two connections, two
# rights: docs/architektura.md #2 "Két DB-kapcsolat, két jog". Build these
# from the POSTGRES_* values below once `docker compose up -d` is running —
# both point at the same database, just different roles/credentials.
DATABASE_URL=postgresql://plantbase:plantbase@localhost:5432/plantbase?schema=public
DATABASE_URL_READONLY=postgresql://plantbase_readonly:plantbase_readonly@localhost:5432/plantbase?schema=public

# Postgres (docker-compose) — task A3
POSTGRES_USER=plantbase
POSTGRES_PASSWORD=plantbase
POSTGRES_DB=plantbase
POSTGRES_PORT=5432

# Postgres readonly role — task A4. Password for the plantbase_readonly
# role created by packages/db/sql/create-readonly-role.sql; must match the
# password embedded in DATABASE_URL_READONLY above.
POSTGRES_READONLY_PASSWORD=plantbase_readonly
